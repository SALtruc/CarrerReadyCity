APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Comma-separated browser origins that can call api/submit-result on Vercel.
# Leave blank if the frontend and API are always served from the same origin.
ALLOWED_ORIGINS=

# Set to true in local/dev to short-circuit /api/submit-result
# and skip the Google Sheets write completely. The frontend already
# bypasses this call automatically on localhost/file://, so this flag
# only matters if you run the API standalone (e.g. `vercel dev`).
BYPASS_RESULT_STORAGE=true
